{
  "name": "zaiko-web",
  "version": "3.0.0",
  "private": true,
  "description": "在庫管理（社内LAN向け Web 版）",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/server.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "e2e": "node e2e/e2e.cjs",
    "seed:demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "fastify": "^5.12.7",
    "jsqr": "^1.4.0",
    "nodemailer": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
