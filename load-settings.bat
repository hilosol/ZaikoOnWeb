@echo off
rem ==== Loads this PC's settings. Called by start.bat / run-server.bat / register-autostart.bat ====
rem Do not edit this file. Edit settings.bat instead (created from settings.example.bat on first run).
rem Default port is 28003.
set ZAIKO_PORT=28003
if not exist "%~dp0settings.bat" if exist "%~dp0settings.example.bat" copy /y "%~dp0settings.example.bat" "%~dp0settings.bat" >nul
if exist "%~dp0settings.bat" call "%~dp0settings.bat"
